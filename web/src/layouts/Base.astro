---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content="Capa de decisiones para agentes: el agente propone, Jev evalúa, las políticas autorizan." />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg: #0b0f14;
    --panel: #131a22;
    --panel-2: #0f141b;
    --border: #243040;
    --text: #e6edf3;
    --muted: #8b98a8;
    --accent: #5ac8fa;
    --ok: #3fb950;
    --warn: #e3b341;
    --block: #f85149;
    --info: #58a6ff;
    --mono: ui-monospace, "SF Mono", "JetBrains Mono", Menlo, Consolas, monospace;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    background: radial-gradient(1200px 600px at 70% -10%, #15202b 0%, var(--bg) 60%);
    color: var(--text);
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    line-height: 1.5;
    min-height: 100vh;
  }

  a { color: var(--accent); }

  .wrap {
    max-width: 1180px;
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
  }

  h1 { font-size: 1.7rem; margin: 0 0 0.25rem; }
  h2 { font-size: 1.15rem; margin: 0 0 0.75rem; }

  .lede { color: var(--muted); margin: 0 0 1.75rem; max-width: 70ch; }
  .lede strong { color: var(--text); }

  code, .mono { font-family: var(--mono); }
</style>
